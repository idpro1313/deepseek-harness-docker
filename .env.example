# OpenAI-compatible gateway (required). Usually ends with /v1.
DSH_LLM_BASE_URL=https://gateway.example/v1

# Gateway API key (required). Runtime only — never baked into the image.
DSH_LLM_API_KEY=sk-replace-me

# Model id sent on the wire (required).
DSH_MODEL=my-model

# Host header the other PC uses in the browser (required).
# Example: LAN IP of this Windows machine, without http:// or path.
DSH_TRUSTED_HOST=192.168.1.50

# Host folder mounted as the agent workspace inside the container.
WORKSPACE_PATH=C:\path\to\project
